# Base URL del backend externo (API propia del proyecto). Consumida
# directamente como process.env.API_URL por server/services/** (Nitro,
# nunca se bundlea al cliente) — mismo patrón y mismo nombre de variable que
# API_URL en next-16-tailwind-4-base-app. Ver .project_docs/api_client.md.
API_URL=

# Secreto de cifrado de la sesión de next-auth (server/utils/authOptions.ts).
# Mismo nombre de variable que NEXTAUTH_SECRET en next-16-tailwind-4-base-app
# — a diferencia de next-auth "puro", @sidebase/nuxt-auth NO cae solo en esta
# variable si no se pasa `secret` explícito a NuxtAuthHandler(); se lee aquí
# a mano para preservar el nombre. Requerida en producción (lanza si falta);
# en dev usa un secreto inseguro con warning si se omite.
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=

# Origen completo (protocolo+host+puerto) + ruta del endpoint de auth, solo
# necesario en producción — en dev @sidebase/nuxt-auth lo infiere de la
# petición entrante. Sin equivalente 1:1 a NEXTAUTH_URL de Next (esa variable
# en next-auth "puro" apunta solo al origen y el propio next-auth le añade
# /api/auth; aquí AUTH_ORIGIN debe incluir ya la ruta completa, es una
# convención propia de @sidebase/nuxt-auth) — ver .project_docs/auth.md.
# Ejemplo: https://miapp.com/api/auth
AUTH_ORIGIN=

# Nombre de la app, expuesto al cliente vía runtimeConfig.public.appName
# (nuxt.config.ts) — usado por app/stores/* para namespanear la key de
# persistencia en localStorage. Equivalente a NEXT_PUBLIC_APP_NAME en
# next-16-tailwind-4-base-app, pero leído por convención NUXT_PUBLIC_* en vez
# de inlineado en build-time (Nuxt no expone process.env al cliente sin pasar
# por runtimeConfig.public). Ver .project_docs/state.md.
NUXT_PUBLIC_APP_NAME=

# Site key de reCAPTCHA v3, expuesto al cliente vía
# runtimeConfig.public.captchaSiteKey (nuxt.config.ts) — usado por
# Recaptcha.vue (inyección del script) y app/utils/captcha.ts
# (getCaptchaToken). Equivalente a NEXT_PUBLIC_CAPTCHA_SITE_KEY en
# next-16-tailwind-4-base-app. Ver .project_docs/auth.md.
NUXT_PUBLIC_CAPTCHA_SITE_KEY=

# Secret key de reCAPTCHA v3, server-only — leído directo de process.env por
# server/utils/captcha.ts (verifyCaptchaToken), mismo criterio que API_URL
# (nunca por runtimeConfig). Equivalente a CAPTCHA_SECRET_KEY en
# next-16-tailwind-4-base-app. Ver .project_docs/auth.md.
CAPTCHA_SECRET_KEY=

# Tema por defecto ("dark"/"light") para la primera visita, antes de que
# exista nada guardado en localStorage — consumido directo por process.env en
# el bloque `colorMode` de nuxt.config.ts (contexto Node, nunca bundleado al
# cliente), mismo criterio que API_URL. Equivalente a NEXT_PUBLIC_DEFAULT_THEME
# en next-16-tailwind-4-base-app. Si se omite, ThemeToggle.vue usa "dark".
NUXT_PUBLIC_DEFAULT_THEME=dark
